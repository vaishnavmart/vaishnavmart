# ==============================================================================
# VAISHNAVA MART (RAS KAN) - WORLD-CLASS ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# For production deployment on Vercel, enter these values in Project Settings -> Environment Variables.
# NEVER COMMIT .env.local OR SENSITIVE SECRETS TO GITHUB.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SITE & CANONICAL URL CONFIGURATION
# ------------------------------------------------------------------------------
# In production on Vercel: https://vaishnavamart.com
# In local development: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://vaishnavamart.com

# Data Persistence Engine: 'firebase' (production) or 'mock' (local offline demo)
NEXT_PUBLIC_DATA_MODE=firebase

# ------------------------------------------------------------------------------
# 2. FIREBASE CLIENT SDK CONFIGURATION (Project: raskan-id)
# ------------------------------------------------------------------------------
# Client keys are public by design in Firebase architecture and restricted via Security Rules.
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=raskan-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=raskan-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=raskan-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=YOUR_FIREBASE_MEASUREMENT_ID

# ------------------------------------------------------------------------------
# 3. RAZORPAY PAYMENT GATEWAY (SERVER-SIDE & CLIENT INTEGRATION)
# ------------------------------------------------------------------------------
# Set to 'razorpay' for live/sandbox gateway or 'mock' for local sandbox testing
PAYMENT_PROVIDER=razorpay

# Razorpay Key ID (Public - used by client checkout modal)
# Test: rzp_test_xxxxxxxxxxxxxx | Live: rzp_live_xxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID

# Razorpay Key Secret (STRICTLY PRIVATE - Server-side only, NEVER expose to client)
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

# Razorpay Webhook Secret (Used in /api/payments/webhook to verify HMAC signatures)
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# ------------------------------------------------------------------------------
# 4. STORE OPERATIONS, CONCIERGE & WHATSAPP
# ------------------------------------------------------------------------------
# Official 10-digit WhatsApp business support number (without + or spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER=8595268400

# Public customer support contact email
NEXT_PUBLIC_CONTACT_EMAIL=raskanfood@gmail.com

# ------------------------------------------------------------------------------
# 5. SUPERADMIN OWNER PORTAL AUTHENTICATION
# ------------------------------------------------------------------------------
# Master credentials for administrative portal access (/owner-login and /admin)
DEV_ADMIN_EMAIL=raskanfood@gmail.com
DEV_ADMIN_PASSWORD=YOUR_STRONG_ADMIN_PASSWORD
