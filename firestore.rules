rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'super_admin' ||
        (request.auth.token.email != null && request.auth.token.email in [
          'raskanwork@gmail.com',
          'raskanfood@gmail.com',
          'yashveerlabs@gmail.com',
          'yashveersinghrajpoot@gmail.com',
          'jasneetkakkar2016@gmail.com',
          'ravigoodyear@gmail.com',
          'owner@vaishnavamart.local'
        ])
      );
    }

    // Public Collections (Catalog, Categories, Pages, Settings)
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pages/{pageSlug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pageVersions/{versionId} {
      allow read, write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customer Profiles Directory
    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
    }

    // Cart Management
    match /carts/{userId} {
      allow read, write: if true;
    }

    // Customer Orders Pipeline
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Operational Logs & Notifications
    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    match /notifications/{notifId} {
      allow read, write: if true;
    }
  }
}
